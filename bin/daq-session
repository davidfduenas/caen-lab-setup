#!/usr/bin/env bash
# Start the digitizer tmux session with the settings written by install.sh.
here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
[[ -f "$here/lab-env.sh" ]] || { echo "lab-env.sh missing: run ./install.sh first" >&2; exit 1; }
source "$here/lab-env.sh"
exec "$here/tmuxsessions/start_digcaen.sh" "$@"
